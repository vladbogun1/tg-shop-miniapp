{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/features/translation": ["./translation-shim.ts"],
      "@/*": ["../../frontend-admin/*"],
      "@shop/core/*": ["../../packages/core/src/*"]
    }
  },
  "include": ["*.ts", "*.mts"]
}
