# Prod TLS front for the OLD shop addresses https://maxsolkh.shop:666 / :667.
#
# Since v3.1.0 the shop lives on chisetup.com.ua behind the host's edge Caddy (~/edge on server 1):
#   https://chisetup.com.ua        -> gateway-site (website)
#   https://app.chisetup.com.ua    -> gateway      (customer Mini App)
#   https://admin.chisetup.com.ua  -> gateway-admin
# :667 only REDIRECTS there permanently, so installed admin shortcuts keep working; :666 serves the
# Mini App itself (see below). The Telegram launch data travels in the URL fragment (#tgWebAppData),
# which browsers carry over a redirect, so an old web_app button still opens a signed-in Mini App.
#
# Certs are the certbot-managed maxsolkh.shop files (mounted at /certs), renewed by the host cron;
# auto-ACME is impossible on these ports. Retire this service (and the cron) once nobody hits it.

{
	# We supply certs explicitly per-site; don't let Caddy try to issue/redirect on 80/443.
	auto_https disable_redirects
}

# PROD_CERT_DIR mounts the whole letsencrypt root at /certs, so the relative
# live/ -> ../../archive symlinks resolve inside the container.
# The OLD Mini App address is SERVED here, not redirected. Telegram binds the Mini App bridge to the
# origin of the URL it launched: an old web_app button (bot messages sent before v3.1.0 still carry
# https://maxsolkh.shop:666/...) that ended on app.chisetup.com.ua after a 301 got a DEAD bridge on
# every client — no safe area/theme events, openLink/fullscreen/haptics silently dropped (~30 % of
# launches in Oct 2026, see docs/TG-DEAD-BRIDGE.md). Same gateway as app.chisetup.com.ua; Host and
# Origin are rewritten so the backend (CORS, WebSocket handshake, absolute links) sees the new address.
maxsolkh.shop:666 {
	tls /certs/live/maxsolkh.shop/fullchain.pem /certs/live/maxsolkh.shop/privkey.pem
	encode zstd gzip
	reverse_proxy gateway:80 {
		header_up Host app.chisetup.com.ua
		header_up Origin https://app.chisetup.com.ua
		header_up X-Real-IP {remote_host}
	}
}

maxsolkh.shop:667 {
	tls /certs/live/maxsolkh.shop/fullchain.pem /certs/live/maxsolkh.shop/privkey.pem
	redir https://admin.chisetup.com.ua{uri} permanent
}
