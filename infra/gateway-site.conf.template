# Single-origin gateway for the public WEBSITE (https://maxsolkh.shop, root domain, 443 via Caddy):
#   /        -> site (Next.js, site-public:3000)
#   /api/    -> backend REST   (HttpOnly cookie auth works because everything is one origin)
#   /ws      -> backend WebSocket (STOMP; the handshake carries the access cookie)
#   /img/    -> imgproxy via the caching nginx
# Used by docker-compose.public.yml (service gateway-site); the Mini App gateway is unaffected.
#
# This file is an nginx TEMPLATE (envsubst at container start, NGINX_ENVSUBST_FILTER=SITE_GATE):
# ${SITE_GATE_CODE} = access code for the pre-launch "closed site" gate. Pages need a cookie
# site_gate=<code>; without it a small code form is shown. /api, /ws and /img stay open (the Mini
# App and the backend's own checks protect them). Empty SITE_GATE_CODE = site is open.

map $cookie_site_gate $site_gate_open {
    default 0;
    "${SITE_GATE_CODE}" 1;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 25m;

    # Re-resolve upstreams per request (see gateway.conf): a recreated container must not leave
    # the gateway talking to a dead IP.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # A shop website is never framed (unlike the Mini App, which Telegram frames).
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location ~ ^/(swagger-ui|swagger-ui\.html|v3/api-docs|actuator) {
        return 404;
    }

    # The site's service routes (POST /_site/revalidate) are called by the backend over the compose
    # network (http://site-public:3000/_site/revalidate), never from the internet.
    location /_site/ {
        return 404;
    }

    location /api/media {
        set $up_backend backend;
        proxy_pass http://$up_backend:8080$request_uri;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }

    location /api/ {
        set $up_backend backend;
        proxy_pass http://$up_backend:8080$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /ws {
        set $up_backend backend;
        proxy_pass http://$up_backend:8080$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
    }

    location /img/ {
        set $up_images nginx;
        proxy_pass http://$up_images:80$request_uri;
        proxy_set_header Host $host;
    }

    # Pre-launch gate page (see the header). Inline so it needs no extra files or upstreams.
    location = /__gate {
        internal;
        default_type text/html;
        add_header Cache-Control "no-store" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        return 200 '<!doctype html><html lang="uk"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>MAXSOLCH</title><style>body{margin:0;min-height:100vh;display:grid;place-items:center;background:#f4f1e8;font-family:system-ui,sans-serif;color:#141414}form{border:3px solid #141414;box-shadow:6px 6px 0 #141414;background:#fff;padding:28px;width:min(340px,86vw)}h1{margin:0 0 6px;font-size:24px;font-weight:900}p{margin:0 0 16px;color:#555}input{box-sizing:border-box;width:100%;border:3px solid #141414;padding:12px;font-size:18px}button{margin-top:12px;width:100%;border:3px solid #141414;background:#ff5a1f;color:#fff;padding:12px;font-size:16px;font-weight:900;box-shadow:4px 4px 0 #141414;cursor:pointer}#e{display:none;color:#c1121f;margin-top:10px;font-weight:700}</style></head><body><form id="f"><h1>MAXSOLCH</h1><p>Сайт ще закритий. Введіть код доступу.</p><input id="c" autocomplete="off" autofocus><button>Увійти</button><div id="e">Невірний код</div></form><script>if(document.cookie.indexOf("site_gate=")>=0){document.getElementById("e").style.display="block"}document.getElementById("f").onsubmit=function(ev){ev.preventDefault();document.cookie="site_gate="+encodeURIComponent(document.getElementById("c").value.trim())+";path=/;max-age=2592000;samesite=lax;secure";location.reload()}</script></body></html>';
    }

    # Everything else -> the website. Next's own caching headers are kept as they are.
    location / {
        if ($site_gate_open = 0) {
            rewrite ^ /__gate last;
        }
        set $up_site site-public;
        proxy_pass http://$up_site:3000$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
