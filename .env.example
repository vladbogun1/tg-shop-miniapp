# tg-shop-v2 environment — copy to .env and fill in secrets.
#   cp .env.example .env
# All values below are wired into docker-compose.yml.

# ── DB (new MySQL 8.4) ───────────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=tgshop_v2
DB_USER=tgshop
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root

# ── JWT ──────────────────────────────────────────────────────────────
# Use a base64-encoded 256-bit secret, e.g.: openssl rand -base64 32
JWT_SECRET=base64-256bit-secret-change-me
JWT_ACCESS_TTL_MINUTES=120
# Admin token lifetime (minutes): short, re-issued silently while the panel is in use.
ADMIN_TOKEN_TTL_MINUTES=720

# ── Runtime profile ──────────────────────────────────────────────────
# "dev" is the ONLY profile that tolerates ALLOW_UNSIGNED_INIT_DATA=true and placeholder
# secrets; with anything else (including prod) the backend refuses to start. Leave it as dev
# locally — docker-compose.prod.yml forces "prod" on the server.
SPRING_PROFILES_ACTIVE=dev
# Business timezone for analytics day buckets.
APP_TIMEZONE=Europe/Kyiv

# ── Telegram bot ─────────────────────────────────────────────────────
BOT_TOKEN=
BOT_USERNAME=@ChannelCheckerBot
INITDATA_TTL_SECONDS=86400
# DEV ONLY. With this on, Telegram initData signatures are NOT verified: anyone can mint
# themselves an admin token. The backend refuses to start with it outside the dev profile.
ALLOW_UNSIGNED_INIT_DATA=false

# ── Telegram notify channels (multi-group with status topics) ────────
NOTIFY_CHAT_ID=-1003606305228
NOTIFY_TOPIC_NEW=2049
NOTIFY_TOPIC_PROCESSING=2051
NOTIFY_TOPIC_SHIPPED=2053
NOTIFY_TOPIC_CLOSED=2055

# ── URLs (Mini App / admin web) ──────────────────────────────────────
WEBAPP_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001

# ── Public site (site/, бэкенд-часть) ────────────────────────────────
# SITE_BASE_URL          — origin сайта; добавляется в разрешённые origin (WebSocket и
#                          проверка Origin для запросов с cookie-авторизацией). Прод: https://chisetup.com.ua
# WEB_COOKIE_SECURE      — флаг Secure у cookie входа (access/refresh/login_bind). Пусто = true,
#                          а в профиле dev = false (локально сайт на http).
# SITE_REVALIDATE_URL    — куда слать ISR-ревалидацию после правок товаров/тегов
#                          (напр. http://site-public:3000/api/revalidate). Пусто = не слать.
# SITE_REVALIDATE_SECRET — заголовок x-revalidate-secret (openssl rand -hex 32).
SITE_BASE_URL=http://localhost:3006
WEB_COOKIE_SECURE=
SITE_REVALIDATE_URL=
SITE_REVALIDATE_SECRET=

# ── Web Push для админки-PWA (уведомления на телефон владельца) ───────
# Пусто = push выключен (бэкенд стартует как обычно, в «Настройках» будет «не настроено»).
# Сгенерировать пару ключей (один раз; при смене ключей все устройства надо подписать заново):
#   openssl ecparam -name prime256v1 -genkey -noout -out vapid.pem
#   openssl ec -in vapid.pem -outform DER | tail -c +8 | head -c 32 | base64 | tr '/+' '_-' | tr -d '=\n'   # -> VAPID_PRIVATE_KEY
#   openssl ec -in vapid.pem -pubout -outform DER | tail -c 65 | base64 | tr '/+' '_-' | tr -d '=\n'      # -> VAPID_PUBLIC_KEY
#   (или: npx web-push generate-vapid-keys — Public Key / Private Key подходят как есть)
# VAPID_SUBJECT — контакт для push-сервисов: mailto:почта-владельца или https://адрес-сайта.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── Онлайн-оплата: monobank эквайринг (docs/MONOBANK-ACQUIRING.md) ────
# Заказ оплачивается только онлайн (целиком или предоплатой). Пусто = оплата выключена:
# покупатели оформят заказ, но не смогут его оплатить (на проде бэкенд пишет WARN при старте).
# MONOBANK_TOKEN       — X-Token. Тестовый: https://api.monobank.ua/ (вход через приложение
#                        monobank — тестовые карты, деньги не списываются). Боевой: кабинет
#                        мерчанта https://web.monobank.ua/ → «Інтернет-еквайринг» → токен.
# MONOBANK_WEBHOOK_URL — куда monobank шлёт статусы. Пусто = SITE_BASE_URL/api/payments/mono/webhook
#                        (адрес должен быть публичным HTTPS; локально — через ngrok).
# MONOBANK_API_URL     — по умолчанию https://api.monobank.ua
# PAYMENT_DUE_HOURS    — сколько часов заказ ждёт оплаты, потом отменяется и товар
#                        возвращается на склад (по умолчанию 24).
# PAYMENT_INVOICE_TTL_MINUTES — срок жизни одной ссылки на оплату, мин (по умолчанию 60).
MONOBANK_TOKEN=
MONOBANK_WEBHOOK_URL=
# MONOBANK_API_URL=https://api.monobank.ua
# PAYMENT_DUE_HOURS=24
# PAYMENT_INVOICE_TTL_MINUTES=60

# ── Карта пользователей в админке (IP → город, офлайн-база DB-IP City Lite) ─
# База скачивается в образ бэкенда при сборке (backend/Dockerfile, /app/geoip/dbip-city-lite.mmdb).
# Обновить: пересобрать образ с `--no-cache-filter geoip` (база выходит раз в месяц).
# Нет базы = на карте нет точек, остальное работает. GEOIP_ENABLED=false — IP не запоминаются вовсе.
# GEOIP_ENABLED=true
# GEOIP_PATH=/app/geoip/dbip-city-lite.mmdb

# ── MinIO / S3 ───────────────────────────────────────────────────────
# S3_ENDPOINT — in-cluster endpoint used by backend & imgproxy.
# S3_ACCESS_KEY / S3_SECRET_KEY double as MinIO root credentials.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me_minio
S3_BUCKET=product-images

# ── imgproxy ─────────────────────────────────────────────────────────
# Optional: leave EMPTY to use unsigned (/insecure/...) URLs, which is what the frontends build.
# Setting these makes imgproxy REJECT unsigned URLs, so do not set them until the frontends
# switch to signed URLs. The bucket is private either way and IMGPROXY_ALLOWED_SOURCES limits
# imgproxy to our own bucket, so it cannot be used as an open proxy.
IMGPROXY_KEY=
IMGPROXY_SALT=
# Public image base URL (nginx cache in front of imgproxy, host port 8082)
IMAGE_BASE_URL=http://localhost:8082/img

# ── Frontend (Next.js, NEXT_PUBLIC_* are baked at build time) ────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_IMAGE_BASE_URL=http://localhost:8082/img

# Admin browser login. Admins live in the admin_users table (not in .env): this pair only CREATES the
# bootstrap admin while there is no active admin with a password at all; after that the password is
# changed in the panel («Мой аккаунт») and ADMIN_PASSWORD is ignored. To revoke someone:
# admin_users.active = 0 (their tokens die within ~30 s), or «Выйти на всех устройствах» in the panel.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me_admin
ADMIN_BOOTSTRAP_TG_ID=593289478
# Two-factor sign-in (TOTP, mandatory). AES-256 key for the admins' 2FA secrets at rest:
#   openssl rand -base64 32
# Set it BEFORE the admins set up 2FA and never change it afterwards (the stored secrets would become
# unreadable — then only ADMIN_EMERGENCY_RESET helps). Blank = derived from JWT_SECRET (a warning).
ADMIN_2FA_KEY=
# Emergency: the owner lost the phone with the authenticator. true + a NEW ADMIN_PASSWORD, restart the
# backend: the bootstrap admin gets that password, 2FA and every session are reset (once per
# ADMIN_PASSWORD value). Then remove the flag. Details: docs/ADMIN-2FA.md
ADMIN_EMERGENCY_RESET=false
# Optional: /api/auth/admin/* requests per IP per 5 min (default 20), remembered-device lifetime
# (default 30 days), max age of Telegram initData for the admin sign-in (default 300 s).
# ADMIN_AUTH_RATE_LIMIT=20
# ADMIN_TRUSTED_DEVICE_DAYS=30
# ADMIN_INITDATA_TTL_SECONDS=300

# ── PROD only (docker-compose.prod.yml — server deploy) ──
# Pre-built images are pulled from Docker Hub (built by .github/workflows/publish.yml).
DOCKERHUB_USERNAME=vladbogun1
# First deploy: a fixed version (NOT latest). After verifying: latest.
IMAGE_TAG=v2.0.0
# Host dir with the certbot-managed maxsolkh.shop certs, mounted read-only into the `caddy` service —
# it only serves the legacy :666/:667 redirects (infra/Caddyfile.prod).
PROD_CERT_DIR=/home/ubuntu/TELEGRAM_BOTS/maxsolch-mini-app/caddy/letsencrypt
# Public URLs for prod (since v3.1.0 — subdomains behind the host's edge Caddy, no ports):
#   WEBAPP_BASE_URL=https://app.chisetup.com.ua
#   ADMIN_BASE_URL=https://admin.chisetup.com.ua
#   SITE_BASE_URL=https://chisetup.com.ua
# The old https://maxsolkh.shop:666/:667 only redirect there (infra/Caddyfile.prod).
