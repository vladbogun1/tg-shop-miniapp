# tg-shop-v2 environment — copy to .env and fill in secrets.
#   cp .env.example .env
# All values below are wired into docker-compose.yml.

# ── DB (new MySQL 8.4) ───────────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=tgshop_v2
DB_USER=tgshop
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root

# ── JWT ──────────────────────────────────────────────────────────────
# Use a base64-encoded 256-bit secret, e.g.: openssl rand -base64 32
JWT_SECRET=base64-256bit-secret-change-me
JWT_ACCESS_TTL_MINUTES=120

# ── Telegram bot ─────────────────────────────────────────────────────
BOT_TOKEN=
BOT_USERNAME=@ChannelCheckerBot
ADMIN_USER_IDS=593289478,977067472
INITDATA_TTL_SECONDS=86400
ALLOW_UNSIGNED_INIT_DATA=false

# ── Telegram notify channels (multi-group with status topics) ────────
NOTIFY_CHAT_ID=-1003606305228
NOTIFY_TOPIC_NEW=2049
NOTIFY_TOPIC_PROCESSING=2051
NOTIFY_TOPIC_SHIPPED=2053
NOTIFY_TOPIC_CLOSED=2055

# ── URLs (Mini App / admin web) ──────────────────────────────────────
WEBAPP_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001

# ── MinIO / S3 ───────────────────────────────────────────────────────
# S3_ENDPOINT        — in-cluster endpoint used by backend & imgproxy.
# S3_PUBLIC_ENDPOINT — endpoint reachable from outside Docker (uploads/debug).
# S3_ACCESS_KEY / S3_SECRET_KEY double as MinIO root credentials.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me_minio
S3_BUCKET=product-images

# ── imgproxy ─────────────────────────────────────────────────────────
# Generate fresh hex keys (DO NOT reuse the placeholders):
#   openssl rand -hex 32   # -> IMGPROXY_KEY
#   openssl rand -hex 32   # -> IMGPROXY_SALT
IMGPROXY_KEY=<hex>
IMGPROXY_SALT=<hex>
# Public image base URL (nginx cache in front of imgproxy, host port 8082)
IMAGE_BASE_URL=http://localhost:8082/img

# ── Frontend (Next.js, NEXT_PUBLIC_* are baked at build time) ────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_IMAGE_BASE_URL=http://localhost:8082/img

# ── Old DB (for the one-off migration tool, runs outside compose) ────
OLD_DB_URL=jdbc:mysql://localhost:3330/tg_test
OLD_DB_USER=root
OLD_DB_PASSWORD=root

# Admin browser login
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me_admin
ADMIN_BOOTSTRAP_TG_ID=593289478

# ── PROD only (docker-compose.prod.yml — server deploy on :666/:667) ──
# Pre-built images are pulled from Docker Hub (built by .github/workflows/publish.yml).
DOCKERHUB_USERNAME=vladbogun1
# First deploy: a fixed version (NOT latest). After verifying: latest.
IMAGE_TAG=v2.0.0
# Domain (cert reused from the old app's Let's Encrypt material).
DOMAIN=maxsolkh.shop
# Host dir with fullchain.pem + privkey.pem for DOMAIN (mounted read-only into Caddy).
PROD_CERT_DIR=/home/ubuntu/TELEGRAM_BOTS/maxsolch-mini-app/caddy/letsencrypt
# Public URLs for prod (note the non-standard HTTPS ports):
#   WEBAPP_BASE_URL=https://maxsolkh.shop:666
#   ADMIN_BASE_URL=https://maxsolkh.shop:667
