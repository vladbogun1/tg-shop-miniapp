{
  "name": "@shop/core",
  "version": "1.0.0",
  "private": true,
  "sideEffects": false,
  "description": "Pure TypeScript core of the shop frontends (no React): money, time, storage, errors, query presets, http, i18n core, order/cart/compare/giftcase rules, DTO types",
  "exports": {
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@tanstack/query-core": "^5.0.0"
  },
  "peerDependencies": {
    "@stomp/stompjs": ">=7"
  },
  "scripts": {
    "lint": "eslint . --quiet",
    "lint:warn": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.4",
    "typescript": "^5.7.0"
  }
}
