{
  "name": "@shop/ui",
  "version": "1.0.0",
  "private": true,
  "sideEffects": false,
  "description": "React primitives on CSS tokens shared by the Mini App and the website: cn, tap, motion presets, brand logo, gift case UI. Knows nothing about the backend beyond @shop/core types",
  "exports": {
    "./gift-case": "./src/gift-case/index.ts",
    "./brand/*": "./src/brand/*.ts",
    "./*": "./src/*.ts"
  },
  "peerDependencies": {
    "framer-motion": ">=11",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@shop/core": "*"
  },
  "scripts": {
    "lint": "eslint . --quiet",
    "lint:warn": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  }
}
