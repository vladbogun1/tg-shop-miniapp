# Copy to .env next to docker-compose.yml and fill in. Never commit the real .env.

# --- image ---
# Release to run, without the "invite-bot-v" prefix: git tag invite-bot-v1.0.0 -> image tag 1.0.0
INVITE_BOT_TAG=
# Docker Hub namespace (default vladbogun1)
# DOCKERHUB_USERNAME=

# --- bot ---
TZ=
BOT_TOKEN=
BOT_USERNAME=
LANDING_IMAGE_URL=

# --- optional: landing text and buttons (defaults are in src/main/resources/application.yml) ---
# Leave commented out to keep the default; an empty value would replace it with an empty string.
# INVITE_CAPTION=
# INVITE_SHOP_TEXT=
# INVITE_SHOP_URL=
# INVITE_REVIEWS_TEXT=
# INVITE_REVIEWS_URL=
# INVITE_CHANNEL_TEXT=
# INVITE_CHANNEL_URL=
